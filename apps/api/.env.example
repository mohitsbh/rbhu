# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Database (portable local PostgreSQL) – %40 is URL-encoded '@'
DATABASE_URL=postgresql://rbhu:RbhuDemo%40123@localhost:5433/rbhu_platform?schema=public

# Auth
JWT_SECRET=change-me-dev-only-secret
JWT_EXPIRES_IN=60m

# Logging
LOG_LEVEL=info

# AI assistant (provider-agnostic OpenAI-compatible adapter).
# Leave OPENAI_API_KEY empty to use the built-in deterministic mock fallback.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For Azure OpenAI deployments, set your resource/deployment URL and version:
# OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
# OPENAI_API_VERSION=2024-02-01
